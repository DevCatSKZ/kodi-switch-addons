<?xml version='1.0' encoding='utf-8'?>
<addon id="repository.kodi-switch" name="Kodi Switch Add-on repository" version="1.0.0" provider-name="Kodi Switch port">
  <requires>
    <import addon="xbmc.addon" version="12.0.0" />
  </requires>
  <extension point="xbmc.addon.repository">
    <dir>
      <info>sdmc:/switch/kodi-public/repository/addons.xml</info>
      <checksum verify="sha256">sdmc:/switch/kodi-public/repository/addons.xml.sha256</checksum>
      <datadir zip="true">sdmc:/switch/kodi-public/repository/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>switch</platform>
    <summary lang="en_GB">Binary add-ons and game cores for the Nintendo Switch</summary>
    <description lang="en_GB">PVR clients, input streams, audio and image decoders, visualizations, screensavers and libretro game cores, built for the Nintendo Switch port of Kodi. Install the add-on package to the SD card to use it.</description>
    <license>GPL-2.0-or-later</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>